{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msgblast-benchmarks-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "OIDC_ISSUER": "https://identity.invalid/",
    "OIDC_AUDIENCE": "msgblast-benchmarks",
    "SERVICE_MODE": "disabled",
    "IDENTITY_PROVIDER": "unconfigured",
    "AUTH0_MANAGEMENT_ORIGIN": "https://identity.invalid/",
    "AUTH0_CLIENT_ID": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msgblast-benchmarks-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "msgblast-benchmarks-local-private",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "msgblast-benchmarks-local-jobs" },
    ],
    "consumers": [
      {
        "queue": "msgblast-benchmarks-local-jobs",
        "max_batch_size": 10,
        "max_retries": 5,
      },
    ],
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
