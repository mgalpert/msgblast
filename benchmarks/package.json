{
  "name": "msgblast-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --strict-vars=false",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run types && tsc --noEmit && npm run build",
    "pretest": "npm run build && node test/build-support.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "evidence:api": "node test/api-evidence.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2"
  }
}
