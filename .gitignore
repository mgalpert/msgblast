.build/
build/
.DS_Store
*.xcuserstate
xcuserdata/
__pycache__/
*.pyc
tmp/
.env
.env.*
!.env.example
.local.env

# Keep the selected icon artwork; leave generated explorations local.
output/*
!output/icon-gradients/
output/icon-gradients/*
!output/icon-gradients/32-WhiteToClearSoftFadeBlueGreen.icon/
!output/icon-gradients/32-WhiteToClearSoftFadeBlue.icon/
!output/icon-gradients/32-WhiteToClearSoftFade-Polished.icon/

# Canonical app artwork must be available to cloud checkouts.
!output/app-icons/
output/app-icons/*
!output/app-icons/msgblast.icon/
!output/app-icons/msgblast-dev.icon/
!output/app-icons/msgblast-demo.icon/

# Machine-specific permission-test configuration and raw proof stay private.
permission-testing.local.json
.permission-test-receipts/

# msgblast-remote client state (holds a private device key) if written with --state here.
remote-client-state.json
